# SeeON frontend environment contract.
#
# Copy this file to .env.local (gitignored) and adjust values for your
# local runtime. Only variables actually read by the frontend source are
# listed here; keep this file in sync with src/vite-env.d.ts.
#
# Never add secrets, tokens, or a real deployment/VM URL to this file —
# it is committed and public.

# Base path/origin the frontend API client sends requests to.
# Defaults to "/api/v1" when unset (see src/services/apiClient.ts).
VITE_API_BASE_URL=/api/v1

# Dev-server-only: overrides the Vite dev proxy backend target used by
# vite.config.ts. Not read via import.meta.env and not bundled into the
# client build.
VITE_DEV_BACKEND_ORIGIN=http://localhost:8080

# Feature flag for admin event clip playback UI.
# "true" enables the clip UI; any other value (or unset) disables it.
VITE_EVENT_CLIPS_ENABLED=false
